# Optional overrides — uisp-mcp has no required env vars.
# Authentication is per-request via headers (provided by the MCP caller):
#
#   X-Uisp-Api-Key    A UISP API token, generated in the target UISP
#                     console at Settings -> Users -> your user -> API
#                     tokens. A read-only token is sufficient and
#                     recommended for this server, since it issues no
#                     write calls.
#
#   X-Uisp-Base-Url   The full origin of the customer's UISP instance,
#                     e.g. https://uisp.example.com (no path suffix — the
#                     server appends /nms/api/v2.1). UISP has no shared
#                     multi-tenant cloud endpoint; every deployment,
#                     including Ubiquiti's own UISP Cloud-hosted tier, is
#                     reachable at its own host.
#
# TLS certificate verification stays ON by default for every target host.
# Self-signed UISP instances (common on self-hosted deployments) will see
# upstream_error from every tool call until a future, explicitly opt-in
# mechanism is designed — this is a deliberate default, not a bug.
#
# This server never persists either header value beyond the lifetime of
# one request.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
